<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="view_partner_child_import_wizard" model="ir.ui.view">
            <field name="name">partner.child.import.wizard.form</field>
            <field name="model">res.partner.child.import.wizard</field>
            <field name="arch" type="xml">
                <form string="Import Child Contacts">
                    <group>
                        <field name="file" filename="filename"/>
                        <field name="filename" invisible="1"/>
                    </group>
                    <footer>
                        <button string="Import" type="object" name="action_import_child_contacts" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_partner_child_import_wizard" model="ir.actions.act_window">
            <field name="name">Import Child Contacts</field>
            <field name="res_model">res.partner.child.import.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
    </data>
</odoo>
